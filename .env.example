# SpotLocal ne nécessite AUCUNE clé API (0 configuration requise).
# Variables optionnelles pour le serveur local / Electron :

# Port HTTP du serveur Web (par défaut : 3000)
PORT=3000

# Dossier optionnel contenant vos fichiers audio locaux (.mp3, .flac, .wav, .m4a)
# Par défaut : ./music
# SPOTLOCAL_MUSIC_DIR="./music"

# Activer uniquement pour l'application de bureau Electron (écoute sur 127.0.0.1 au lieu de 0.0.0.0)
# SPOTLOCAL_DESKTOP=0
